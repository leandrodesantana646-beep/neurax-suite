# Função Auxiliar para Chamadas da OpenAI
def chamar_ia(sistema, usuario):
    if not client:
        return "⚠️ ATENÇÃO: Insira a sua chave da API da OpenAI (sk-...) na barra lateral ao lado para ativar a inteligência real do ChatGPT."
    try:
        resposta = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "system", "content": sistema},
                {"role": "user", "content": usuario}
            ],
            temperature=0.7
        )
        return resposta.choices[0].message.content
    except Exception as e:
        return f"❌ Erro ao conectar com a IA: {e}"

